// Dry Run backend — Prisma schema
//
// Two tables, deliberately minimal, mirroring what the existing frontend
// already models in-memory (see src/state/store.ts `ArmEvent`):
//   - users: registered operators (Feature 2 — accounts/auth)
//   - events: persisted command/validation log (Feature 1 — persistent event log)
//
// A `userId` on Event is nullable on purpose: guest operators still generate
// events client-side, and we optionally persist those as anonymous rows so
// the "one gate, one log" story holds even before someone logs in.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  // Admin-recoverable copy of the current password (demo convenience for the
  // admin panel's "view current password" tool). Kept in sync on register,
  // login and admin password resets. The hash above remains what login
  // actually verifies against.
  passwordPlain String?
  role         String   @default("USER") // "USER" or "ADMIN"
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())

  events Event[]

  @@map("users")
}

model Event {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  source    String
  type      String?
  message   String
  level     String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([level])
  @@index([source])
  @@map("events")
}

