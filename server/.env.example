# Copy to .env (git-ignored) before running the server.

# Postgres connection string, e.g.:
# postgresql://USER:PASSWORD@localhost:5432/dry_run?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dry_run?schema=public

# Secret used to sign JWTs. Use a long random string in real deployments —
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# How long an issued token stays valid.
JWT_EXPIRES_IN=7d

# Port the API listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API. Include every
# frontend that needs access — typically the local Vite dev server *and*
# the deployed frontend once you have one, e.g.:
#   CORS_ORIGIN=http://localhost:5173,https://dry-run.vercel.app
# A single origin (just the dev server) is fine for local-only dev, which
# is why this defaults to that alone.
CORS_ORIGIN=http://localhost:5173
