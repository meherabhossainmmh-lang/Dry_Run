# Copy to .env.local (git-ignored). Optional — the app runs fully without it;
# the key only enables the Phase 3B agentic voice layer (Groq LLM).
# Get a key at https://console.groq.com → API Keys.
VITE_GROQ_API_KEY=gsk_your_groq_key_here

# Optional — base URL of the Dry Run backend (see server/). Leave unset and
# the app runs exactly as before: fully client-side, no accounts, no
# persisted history. Set it to enable Feature 1 (persistent event log) and
# Feature 2 (user accounts).
VITE_API_BASE_URL=http://localhost:4000
